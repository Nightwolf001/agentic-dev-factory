# Names only. Copy to dev-factory/.env.local (gitignored) and fill in.
# Shared settings live in dev-factory/config.json; any DF_* variable below overrides it on this machine.

# Unattended auth (output of: claude setup-token)
CLAUDE_CODE_OAUTH_TOKEN=
# Fallback Jira auth if the Atlassian MCP login does not survive unattended runs
JIRA_API_TOKEN=
JIRA_EMAIL=
# Optional: raises the context7 rate limit
CONTEXT7_API_KEY=

# Optional overrides of config.json
# DF_MAX_OPEN_PRS=3
# DF_MAX_CONCURRENT=1
# DF_MAX_BUDGET_USD=40
# DF_JIRA_PROJECTS=OAPP,PLAT,ONE,MAX
# DF_JIRA_LABEL=dev-factory
# DF_MODEL=sonnet
# DF_BUILDER_MODEL=sonnet
# DF_REVIEWER_MODEL=sonnet
# DF_EFFORT=high
# DF_METRO_PORT=8081
