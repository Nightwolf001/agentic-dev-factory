# Names only. `dev-factory install --apply` copies this to ~/.dev-factory/.env.local (mode 600, outside every repository);
# fill in what you use, best with `pbpaste | dev-factory settings set secret:NAME` (the value is read from standard input and
# never appears on a command line). Shared settings live in the plugin's config.json, your ~/.dev-factory/config.json and the
# repository's .devfactory/config.json (see `dev-factory settings`); any DF_* variable below overrides them on this machine.
# A cloud session or a GitHub Actions run also takes DF_PROJECT_CONFIG and DF_PROJECT_QA (the contents of .devfactory/config.json
# and .devfactory/qa.yaml, raw or base64): they are not secrets, so set them as variables, not here.

# Unattended runs only (output of: claude setup-token)
CLAUDE_CODE_OAUTH_TOKEN=
# tasks.source = jira: lets the scheduler check for work without starting a paid session, and the `jira` MCP server reads them
JIRA_API_TOKEN=
JIRA_EMAIL=
# tasks.source = notion: an internal integration secret for the task database
NOTION_TOKEN=
# Optional: raises the context7 rate limit (when that MCP server is enabled)
CONTEXT7_API_KEY=
# Optional: the `github` MCP server (also export it in the shell that starts claude, which expands it)
GITHUB_PERSONAL_ACCESS_TOKEN=

# Optional overrides of the config
# DF_TASK_SOURCE=github
# DF_TASK_LABEL=dev-factory
# DF_GITHUB_REPO=owner/name
# DF_NOTION_DATABASE_ID=
# DF_JIRA_CLOUD_ID=
# DF_JIRA_PROJECTS=APP,WEB
# DF_MAX_OPEN_PRS=3
# DF_MAX_CONCURRENT=1
# DF_MAX_BUDGET_USD=40
# DF_MODEL=sonnet
# DF_BUILDER_MODEL=sonnet
# DF_REVIEWER_MODEL=sonnet
# DF_EFFORT=high
# DF_METRO_PORT=8081
