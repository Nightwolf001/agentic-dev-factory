# Names only. `dev-factory install --apply` copies this to ~/.dev-factory/.env.local (mode 600, outside every repository);
# fill in what you use. Shared settings live in the plugin's config.json plus the repository's dev-factory.config.json;
# any DF_* variable below overrides them on this machine.

# Unattended runs only (output of: claude setup-token)
CLAUDE_CODE_OAUTH_TOKEN=
# tasks.source = jira: lets the scheduler check for work without starting a paid session
JIRA_API_TOKEN=
JIRA_EMAIL=
# tasks.source = notion: an internal integration secret for the task database
NOTION_TOKEN=
# Optional: raises the context7 rate limit (when that MCP server is enabled)
CONTEXT7_API_KEY=

# Optional overrides of the config
# DF_TASK_SOURCE=github
# DF_TASK_LABEL=dev-factory
# DF_GITHUB_REPO=owner/name
# DF_NOTION_DATABASE_ID=
# DF_JIRA_CLOUD_ID=
# DF_JIRA_PROJECTS=APP,WEB
# DF_MAX_OPEN_PRS=3
# DF_MAX_CONCURRENT=1
# DF_MAX_BUDGET_USD=40
# DF_MODEL=sonnet
# DF_BUILDER_MODEL=sonnet
# DF_REVIEWER_MODEL=sonnet
# DF_EFFORT=high
# DF_METRO_PORT=8081
